# ============================================================
# ENVIRONMENT VARIABLES - .env File
# ============================================================
# This file stores sensitive configuration like database URLs
# 
# IMPORTANT: 
# 1. Create a .env file in your root directory
# 2. Copy the contents below and fill in your actual values
# 3. NEVER commit .env to Git (add to .gitignore)
# 4. Keep your MongoDB password SECRET!
# ============================================================

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/databasename?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://umasankar3345_db_user:1234@cluster0.bqdplds.mongodb.net/stayora_test?retryWrites=true&w=majority

# Server Port (optional, defaults to 5000)
PORT=5000

# Node Environment
NODE_ENV=development

# ============================================================
# HOW TO GET YOUR ACTUAL MONGO_URL:
# ============================================================
# 1. Go to MongoDB Atlas Dashboard
# 2. Click "Connect" on your cluster
# 3. Select "Drivers" > "Node.js"
# 4. Copy the connection string
# 5. Replace username and password with actual credentials
# 6. Add database name before "?" (optional)
# 
# Example:
# MONGO_URL=mongodb+srv://user:password@cluster.bqdplds.mongodb.net/mydb?retryWrites=true&w=majority
# ============================================================
